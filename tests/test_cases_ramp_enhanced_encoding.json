{
  "description": "Enhanced test cases to investigate ramp effect parameter encoding improvements",
  "note": "Based on T500RS_Driver_Analysis_and_Improvements.md - targets enhanced ramp parameter mapping",
  "key_levels": {
    "ramp_start": {
      "zero": 0,
      "very_low": 1000,
      "low": 8000,
      "medium": 24000,
      "high": 48000,
      "signed_max": 32767,
      "max": 65535
    },
    "ramp_end": {
      "zero": 0,
      "very_low": 1000,
      "low": 8000,
      "medium": 24000,
      "high": 48000,
      "signed_max": 32767,
      "max": 65535
    }
  },
  "defaults": {
    "direction_deg": 0,
    "length_ms": 2000,
    "delay_ms": 0,
    "attack_length_ms": 0,
    "attack_level": 0,
    "fade_length_ms": 0,
    "fade_level": 0,
    "iterations": 1
  },
  "tests": [
    {
      "id": "ramp_enhanced_zero_to_zero",
      "description": "Enhanced mapping: ramp from 0 to 0 (baseline for magnitude calculation)",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "zero",
        "ramp_end": "zero"
      }
    },
    {
      "id": "ramp_enhanced_avg_magnitude",
      "description": "Enhanced mapping: test midpoint/average magnitude calculation",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "low",
        "ramp_end": "high"
      }
    },
    {
      "id": "ramp_enhanced_directional_offset",
      "description": "Enhanced mapping: test directional offset for ramp direction",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "high",
        "ramp_end": "low",
        "direction_deg": 180
      }
    },
    {
      "id": "ramp_enhanced_phase_handling",
      "description": "Enhanced mapping: test phase parameter for direction (180 degrees)",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "low",
        "ramp_end": "high",
        "phase_deg": 180
      }
    },
    {
      "id": "ramp_enhanced_signed_max_range",
      "description": "Enhanced mapping: ramp across signed max boundary (32767)",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "zero",
        "ramp_end": "signed_max"
      }
    },
    {
      "id": "ramp_enhanced_signed_max_to_max",
      "description": "Enhanced mapping: ramp from signed max to unsigned max",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "signed_max",
        "ramp_end": "max"
      }
    },
    {
      "id": "ramp_enhanced_magnitude_calculation",
      "description": "Enhanced mapping: test magnitude = abs(midpoint) * 127 / 32767",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "medium",
        "ramp_end": "high"
      }
    },
    {
      "id": "ramp_enhanced_offset_calculation",
      "description": "Enhanced mapping: test offset = range * 127 / 32767",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "low",
        "ramp_end": "high"
      }
    },
    {
      "id": "ramp_enhanced_direction_offset_positive",
      "description": "Enhanced mapping: test positive direction offset (ramp up)",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "low",
        "ramp_end": "high"
      }
    },
    {
      "id": "ramp_enhanced_direction_offset_negative",
      "description": "Enhanced mapping: test negative direction offset (ramp down with 180deg phase)",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "high",
        "ramp_end": "low"
      }
    },
    {
      "id": "ramp_enhanced_equal_levels",
      "description": "Enhanced mapping: test constant level (no ramp)",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "medium",
        "ramp_end": "medium"
      }
    },
    {
      "id": "ramp_enhanced_range_calculation",
      "description": "Enhanced mapping: test range calculation for various start/end pairs",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "very_low",
        "ramp_end": "high"
      }
    },
    {
      "id": "ramp_enhanced_midpoint_calculation",
      "description": "Enhanced mapping: test midpoint calculation (start + end) / 2",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "low",
        "ramp_end": "medium"
      }
    },
    {
      "id": "ramp_enhanced_direction_90deg",
      "description": "Enhanced mapping: test ramp direction 90 degrees (right)",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "low",
        "ramp_end": "high",
        "direction_deg": 90
      }
    },
    {
      "id": "ramp_enhanced_direction_270deg",
      "description": "Enhanced mapping: test ramp direction 270 degrees (left)",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "low",
        "ramp_end": "high",
        "direction_deg": 270
      }
    },
    {
      "id": "ramp_enhanced_phase_90deg",
      "description": "Enhanced mapping: test ramp with 90 degree phase offset",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "low",
        "ramp_end": "high",
        "phase_deg": 90
      }
    },
    {
      "id": "ramp_enhanced_phase_270deg",
      "description": "Enhanced mapping: test ramp with 270 degree phase offset",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "low",
        "ramp_end": "high",
        "phase_deg": 270
      }
    },
    {
      "id": "ramp_enhanced_with_envelope",
      "description": "Enhanced mapping: ramp with attack and fade envelope",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "low",
        "ramp_end": "high",
        "attack_length_ms": 500,
        "attack_level": 16000,
        "fade_length_ms": 500,
        "fade_level": 16000
      }
    },
    {
      "id": "ramp_enhanced_short_duration",
      "description": "Enhanced mapping: ramp with short duration (100ms)",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "zero",
        "ramp_end": "max",
        "length_ms": 100
      }
    },
    {
      "id": "ramp_enhanced_long_duration",
      "description": "Enhanced mapping: ramp with long duration (5000ms)",
      "effect_type": "ramp",
      "params": {
        "ramp_start": "zero",
        "ramp_end": "max",
        "length_ms": 5000
      }
    },
    {
      "id": "ramp_enhanced_vs_constant_comparison",
      "description": "Compare enhanced ramp encoding with constant force (should show different packet codes)",
      "sequence": [
        {
          "effect_type": "ramp",
          "start_ms": 0,
          "params": {
            "ramp_start": "medium",
            "ramp_end": "high",
            "length_ms": 1000
          }
        },
        {
          "effect_type": "constant",
          "start_ms": 1200,
          "params": {
            "level": "medium",
            "length_ms": 1000
          }
        }
      ]
    },
    {
      "id": "ramp_enhanced_vs_sine_comparison",
      "description": "Compare enhanced ramp with sine periodic (different packet types)",
      "sequence": [
        {
          "effect_type": "ramp",
          "start_ms": 0,
          "params": {
            "ramp_start": "low",
            "ramp_end": "high",
            "length_ms": 1500
          }
        },
        {
          "effect_type": "sine",
          "start_ms": 1700,
          "params": {
            "magnitude": "medium",
            "period_ms": 100,
            "length_ms": 1500
          }
        }
      ]
    }
  ]
}
