{
  "description": "Test cases to determine valid effect ID range and assignment pattern for multi-effect scenarios",
  "key_levels": {
    "level": {
      "low": 8000,
      "medium": 24000,
      "high": 48000
    }
  },
  "defaults": {
    "direction_deg": 0,
    "length_ms": 3000,
    "delay_ms": 0,
    "attack_length_ms": 0,
    "attack_level": 0,
    "fade_length_ms": 0,
    "fade_level": 0,
    "iterations": 1
  },
  "tests": [
    {
      "id": "effect_id_sequential_0_to_15",
      "description": "Upload 16 effects with sequential IDs 0-15 to test full range",
      "sequence": [
        {"effect_type": "constant", "level": "low", "start_ms": 0, "length_ms": 3000},
        {"effect_type": "constant", "level": "low", "start_ms": 100, "length_ms": 2900},
        {"effect_type": "constant", "level": "low", "start_ms": 200, "length_ms": 2800},
        {"effect_type": "constant", "level": "low", "start_ms": 300, "length_ms": 2700},
        {"effect_type": "constant", "level": "low", "start_ms": 400, "length_ms": 2600},
        {"effect_type": "constant", "level": "low", "start_ms": 500, "length_ms": 2500},
        {"effect_type": "constant", "level": "low", "start_ms": 600, "length_ms": 2400},
        {"effect_type": "constant", "level": "low", "start_ms": 700, "length_ms": 2300},
        {"effect_type": "constant", "level": "low", "start_ms": 800, "length_ms": 2200},
        {"effect_type": "constant", "level": "low", "start_ms": 900, "length_ms": 2100},
        {"effect_type": "constant", "level": "low", "start_ms": 1000, "length_ms": 2000},
        {"effect_type": "constant", "level": "low", "start_ms": 1100, "length_ms": 1900},
        {"effect_type": "constant", "level": "low", "start_ms": 1200, "length_ms": 1800},
        {"effect_type": "constant", "level": "low", "start_ms": 1300, "length_ms": 1700},
        {"effect_type": "constant", "level": "low", "start_ms": 1400, "length_ms": 1600},
        {"effect_type": "constant", "level": "low", "start_ms": 1500, "length_ms": 1500}
      ]
    },
    {
      "id": "effect_id_overflow_17_effects",
      "description": "Upload 17 effects to test behavior when exceeding 16-slot limit",
      "sequence": [
        {"effect_type": "constant", "level": "low", "start_ms": 0, "length_ms": 5000},
        {"effect_type": "constant", "level": "low", "start_ms": 100, "length_ms": 4900},
        {"effect_type": "constant", "level": "low", "start_ms": 200, "length_ms": 4800},
        {"effect_type": "constant", "level": "low", "start_ms": 300, "length_ms": 4700},
        {"effect_type": "constant", "level": "low", "start_ms": 400, "length_ms": 4600},
        {"effect_type": "constant", "level": "low", "start_ms": 500, "length_ms": 4500},
        {"effect_type": "constant", "level": "low", "start_ms": 600, "length_ms": 4400},
        {"effect_type": "constant", "level": "low", "start_ms": 700, "length_ms": 4300},
        {"effect_type": "constant", "level": "low", "start_ms": 800, "length_ms": 4200},
        {"effect_type": "constant", "level": "low", "start_ms": 900, "length_ms": 4100},
        {"effect_type": "constant", "level": "low", "start_ms": 1000, "length_ms": 4000},
        {"effect_type": "constant", "level": "low", "start_ms": 1100, "length_ms": 3900},
        {"effect_type": "constant", "level": "low", "start_ms": 1200, "length_ms": 3800},
        {"effect_type": "constant", "level": "low", "start_ms": 1300, "length_ms": 3700},
        {"effect_type": "constant", "level": "low", "start_ms": 1400, "length_ms": 3600},
        {"effect_type": "constant", "level": "low", "start_ms": 1500, "length_ms": 3500},
        {"effect_type": "constant", "level": "low", "start_ms": 1600, "length_ms": 3400}
      ]
    },
    {
      "id": "effect_id_reuse_after_stop",
      "description": "Test if effect ID can be reused after stopping an effect",
      "sequence": [
        {"effect_type": "constant", "level": "low", "start_ms": 0, "length_ms": 1000},
        {"effect_type": "constant", "level": "medium", "start_ms": 1500, "length_ms": 1000},
        {"effect_type": "constant", "level": "high", "start_ms": 3000, "length_ms": 1000}
      ]
    },
    {
      "id": "effect_id_mixed_types",
      "description": "Test effect IDs with different effect types running simultaneously",
      "sequence": [
        {"effect_type": "constant", "level": "low", "start_ms": 0, "length_ms": 3000},
        {"effect_type": "sine", "magnitude": "low", "period_ms": 100, "start_ms": 500, "length_ms": 2500},
        {"effect_type": "spring", "cond_right_coeff": "low", "cond_left_coeff": "low", "start_ms": 1000, "length_ms": 2000},
        {"effect_type": "damper", "cond_right_coeff": "low", "cond_left_coeff": "low", "start_ms": 1500, "length_ms": 1500}
      ]
    },
    {
      "id": "effect_id_rapid_upload_stop",
      "description": "Rapidly upload and stop effects to test ID management",
      "sequence": [
        {"effect_type": "constant", "level": "low", "start_ms": 0, "length_ms": 200},
        {"effect_type": "constant", "level": "low", "start_ms": 250, "length_ms": 200},
        {"effect_type": "constant", "level": "low", "start_ms": 500, "length_ms": 200},
        {"effect_type": "constant", "level": "low", "start_ms": 750, "length_ms": 200},
        {"effect_type": "constant", "level": "low", "start_ms": 1000, "length_ms": 200},
        {"effect_type": "constant", "level": "low", "start_ms": 1250, "length_ms": 200},
        {"effect_type": "constant", "level": "low", "start_ms": 1500, "length_ms": 200},
        {"effect_type": "constant", "level": "low", "start_ms": 1750, "length_ms": 200}
      ]
    }
  ]
}

